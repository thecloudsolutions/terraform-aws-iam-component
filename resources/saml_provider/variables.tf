variable "name" {
  type        = string
  description = "(Required, Forces new resource) The name of the provider to create."
}

variable "saml_metadata_document" {
  type        = string
  description = "(Required) An XML document generated by an identity provider that supports SAML 2.0."
}

variable "tags" {
  type        = map(string)
  default     = null
  description = "(Optional) Map of resource tags for the IAM SAML provider. If configured with a provider default_tags configuration block present, tags with matching keys will overwrite those defined at the provider-level."
}
